# ==========================================================================
# Archivo de ejemplo — copia este archivo como `.env` y completa los valores.
#   cp .env.example .env       (Linux/Mac)
#   copy .env.example .env     (Windows CMD)
# `.env` está en .gitignore, así que tus credenciales reales nunca se suben.
# ==========================================================================

# --- Credenciales del portal (obligatorias) ---
PORTAL_USER=tu_usuario
PORTAL_PASS=tu_password

# --- URL base del portal (obligatoria) ---
# Sin slash final. Las URLs de login/buscar/descargar se derivan de aquí.
BASE_URL=https://portal.ejemplo.com

# Override opcional si las rutas internas del portal cambian:
# LOGIN_URL=https://portal.ejemplo.com/accounts/login/
# SEARCH_URL=https://portal.ejemplo.com/grabacion/buscar/
# DOWNLOAD_URL=https://portal.ejemplo.com/grabacion/descargar/

# --- Carpeta destino ---
# Acepta rutas locales (C:\downloads) o UNC (\\server\share\subcarpeta).
# Si está vacío, descarga a ./downloads dentro del repo.
# IMPORTANTE para rutas con backslash: NO uses comillas dobles (\\ se interpretaría como \).
DOWNLOADS_DIR=

# --- Credenciales del share UNC (solo si DOWNLOADS_DIR apunta a \\server\share y requiere auth) ---
# Si Windows ya tiene las credenciales guardadas (cmdkey) o no es UNC, deja vacío.
USUARIO_COMPARTIDA=
PASS_COMPARTIDA=

# --- Cuántos días completos anteriores a hoy descargar ---
# 1 = solo ayer (default). Hoy nunca se incluye.
DAYS_BACK=1

# --- Programación ---
# Vacío  → one-shot: descarga una vez y termina (úsalo con Task Scheduler).
# HH:MM  → bucle: el proceso queda corriendo y dispara cada día a esa hora local.
RUN_AT=

# --- Browser ---
# true  → invisible (producción).
# false → visible (debug).
HEADLESS=true

# --- HTTP ---
TIMEOUT=30
SUPPRESS_TLS_WARNINGS=true

# ==========================================================================
# Filtros opcionales (vacío = sin filtro). Mira README para ejemplos.
# ==========================================================================

# Tipo de llamada. Acepta nombre (DIALER, INBOUND, MANUAL, PREVIEW) o el ID (1-4).
TIPO_LLAMADA=

# Teléfono exacto del cliente.
TEL_CLIENTE=

# Call ID exacto.
CALLID=

# Agente: ID numérico o nombre completo del label.
AGENTE=

# Checkboxes: 1/true/yes/sí = marcado, vacío o false = desmarcado.
MARCADAS=
GESTION=

# Una o varias campañas separadas por coma. Acepta IDs o nombres del label.
# Ej: CAMPANAS=12,14,GT-POST-BLOQ
# El bot hace N búsquedas (una por campaña) y deduplica.
CAMPANAS=

# Cuántas grabaciones muestra el portal por página. Subirlo (ej. 100) reduce
# mucho la cantidad de páginas a recorrer y hace la descarga más rápida.
GRABACIONES_X_PAGINA=100
